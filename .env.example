# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# KIE_API_KEY: Required for Kie AI API calls.
KIE_API_KEY="MY_KIE_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HOST: Network interface for the local server. Keep the default local-only value.
HOST="127.0.0.1"

# Higgsfield server-side credentials (never use VITE_ prefixes for secrets)
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Alternatively: HF_CREDENTIALS=key-id:key-secret
