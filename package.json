{
  "name": "kai-media-studio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:improvements": "npm run build && node scripts/check-improvements.mjs && npm run check:polling",
    "check:polling": "tsx scripts/check-kie-polling.ts",
    "check:credits": "tsx scripts/verify-credit-estimates.ts",
    "check:catalog": "tsx scripts/check-kie-catalog.ts",
    "check:providers": "node --import tsx scripts/check-providers.ts",
    "check:generation": "node --import tsx scripts/check-generation.ts",
    "test": "npm run check:providers && npm run check:generation && npm run check:polling && npm run check:credits && npm run check:catalog && npm run check:media",
    "check:media": "node --import tsx scripts/check-media-workflows.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
